; Engine configuration file.
; THE LAST NIGHT — 3D survival horror / zombie defense
; Godot 4.3, GL Compatibility renderer (runs on broad Windows hardware).

config_version=5

[application]

config/name="THE LAST NIGHT"
config/description="Ten nights inside an overrun supermarket. Prep by day, survive by night. 1-4 player co-op survival horror."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.02, 0.025, 0.03, 1)

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/title="THE LAST NIGHT"

[debug]

gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_property_access=0

[physics]

3d/default_gravity=18.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=2
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.05, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
