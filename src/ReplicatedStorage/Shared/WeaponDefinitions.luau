function WeaponDefinitions.Get(weaponId: string): WeaponDef?
	return (WeaponDefinitions.WEAPONS :: any)[weaponId]
end

function WeaponDefinitions.ComputeFalloffMultiplier(def: WeaponDef, distanceStuds: number): number
	if distanceStuds <= def.EffectiveRange then
		return 1.0
	end
	if distanceStuds >= def.MaxRange then
		return def.MinFalloffScale
	end
	local span = math.max(1.0, def.MaxRange - def.EffectiveRange)
	local t = (distanceStuds - def.EffectiveRange) / span
	return 1.0 + (def.MinFalloffScale - 1.0) * t
end

return table.freeze(WeaponDefinitions)
