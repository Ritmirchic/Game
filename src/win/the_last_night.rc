// Windows resources for THE LAST NIGHT: application icon + version info.
// Compiled to a COFF object by `zig rc` and linked into THE_LAST_NIGHT.exe.
#include <windows.h>

1 ICON "assets/ui/icon.ico"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Independent"
            VALUE "FileDescription", "THE LAST NIGHT - cooperative survival horror"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "THE_LAST_NIGHT"
            VALUE "LegalCopyright", "Original work. See CREDITS.txt for asset provenance."
            VALUE "OriginalFilename", "THE_LAST_NIGHT.exe"
            VALUE "ProductName", "THE LAST NIGHT"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
