/* SPACE MINER — Windows resources: icon, version info, DPI-aware app manifest. */
#include <winver.h>

#define SM_ICON 101
#define SM_MANIFEST 1

SM_ICON ICON "spaceminer.ico"

1 24 "spaceminer.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEFLAGSMASK   0x3FL
  FILEFLAGS       0x0L
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Deep Belt Operations"
      VALUE "FileDescription",  "SPACE MINER"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "SPACE_MINER"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Deep Belt Operations"
      VALUE "OriginalFilename", "SPACE_MINER.exe"
      VALUE "ProductName",      "SPACE MINER - Deep Belt Operations"
      VALUE "ProductVersion",   "1.0.0.0"
      VALUE "Comments",         "Procedural space mining, exploration and combat."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
